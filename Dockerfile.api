FROM python:3.14-slim
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
COPY api/ api/
COPY data/processed/win_prob_model_small.pkl data/processed/
COPY data/processed/batting_impact.csv data/processed/bowling_impact.csv data/processed/venue_intelligence.csv data/processed/
COPY data/processed/matches_clean.parquet data/processed/matchups.csv data/processed/player_clusters.csv data/processed/

CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}